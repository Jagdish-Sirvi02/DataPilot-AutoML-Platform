# ─────────────────────────────────────────────────────────────
# DataPilot Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# Application
DEBUG=false

# Redis (required for job state; included in docker-compose)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ML Pipeline settings
MAX_FILE_SIZE_MB=100      # Maximum CSV upload size in MB
CV_FOLDS=5                # Cross-validation folds
OPTUNA_TRIALS=30          # Hyperparameter tuning trials per model (20 = fast, 50 = thorough)
TEST_SIZE=0.2             # Train/test split ratio (0.2 = 80/20)
RANDOM_STATE=42           # Reproducibility seed
