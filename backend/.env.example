# ─────────────────────────────────────────────
# DataPilot Environment Configuration
# Copy to .env and fill in values
# ─────────────────────────────────────────────

# Application
APP_ENV=development        # development | production
DEBUG=false
LOG_LEVEL=INFO

# JWT Auth
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (SQLite for local, swap to PostgreSQL for cloud)
DATABASE_URL=sqlite+aiosqlite:///./datapilot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/datapilot

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage paths
UPLOAD_DIR=/app/data/uploads
OUTPUT_DIR=/app/data/outputs
WORKFLOW_DIR=/app/data/workflows

# ML Settings
MAX_FILE_SIZE_MB=100
CV_FOLDS=5
OPTUNA_TRIALS=30
TEST_SIZE=0.2
RANDOM_STATE=42

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80

# Cloud Storage (optional – leave empty to use local filesystem)
# AWS_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
